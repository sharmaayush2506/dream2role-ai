# Copy this file to ".env" (same folder) and fill in your values.
# .env is git-ignored, so your keys stay on your computer.

# --- AI (pick one; Gemini is used if both are set) ---
# Google Gemini: free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: which Gemini model to use (default gemini-flash-latest; usually best left unset)
# GEMINI_MODEL=gemini-flash-latest

# OpenAI (needs billing credits): https://platform.openai.com/api-keys
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.4-mini

# --- Optional: real payments through Razorpay (otherwise a demo checkout is used) ---
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=

# --- Required in production: a long random string ---
# JWT_SECRET=
